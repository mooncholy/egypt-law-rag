# Copy to .env and fill in. .env is gitignored; this file is committed.
# Only per-machine and secret values belong here. Paths and other project
# parameters live in params.yaml, which ranks above this file.
# tests/test_config.py checks that these keys match Settings. Blank values
# fall back to the field's default.

# LLM access (OpenAI-compatible, D20). Without all three the API starts,
# /health reports "degraded", and /ask answers 503. A local vLLM:
# RAGLAW_LLM_BASE_URL=http://localhost:8002/v1, and its --api-key as the key.
# `docker compose up` sets its own endpoint and key, and reads only the model:
# blank runs qwen2.5:7b-instruct-q8_0; qwen2.5:7b-instruct-q4_K_M fits a machine
# with less than about 16 GB of RAM.
RAGLAW_LLM_API_KEY=
RAGLAW_LLM_BASE_URL=
RAGLAW_LLM_MODEL=

# The RAGAS judge (Phase 9, D23): an OpenAI-compatible endpoint serving a
# stronger model than the generator. Only `evaluate_answers` reads these.
RAGLAW_JUDGE_BASE_URL=
RAGLAW_JUDGE_MODEL=
RAGLAW_JUDGE_API_KEY=

# The models service (D18) that embeds questions and reranks for the API.
# Blank means http://localhost:8001.
RAGLAW_MODELS_URL=

# A copy of the production retriever exported at image build (D26); the API
# image sets it. Blank: the API loads `production` from the registry.
RAGLAW_CHAMPION_DIR=

# Tracking. Two modes:
# - local (default): the sqlite file below, with artifacts written to S3 by
#   each client under RAGLAW_MLFLOW_ARTIFACT_ROOT;
# - the shared server (docker/compose.tracking.yml):
#   RAGLAW_MLFLOW_TRACKING_URI=http://localhost:5000 and a blank
#   RAGLAW_MLFLOW_ARTIFACT_ROOT, since the server stores artifacts itself.
RAGLAW_S3_BUCKET=mlops-rag-data-773317598646-eu-north-1-an
RAGLAW_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
RAGLAW_MLFLOW_ARTIFACT_ROOT=s3://mlops-rag-data-773317598646-eu-north-1-an/mlflow
RAGLAW_AWS_PROFILE=mlops-practitioner

# Models (embedding, reranking): cpu (default) or cuda. cuda needs the
# torch-gpu dependency group; see the README's GPU section.
RAGLAW_DEVICE=

# Not read from this file: RAGLAW_LOG_LEVEL (default INFO) sets the API's log
# level, and raglaw.logging_conf reads it from the process environment only.
# Set it with `RAGLAW_LOG_LEVEL=DEBUG uv run uvicorn ...` or in Docker's env.
